<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/root"
        android:layout_width="@dimen/vs_640"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/shape_dialog_pg_search_checkbox"
        android:orientation="vertical"
        android:padding="@dimen/vs_20">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/dialog_text_primary"
            android:textSize="@dimen/ts_28"
            android:text="第二配置源（与主源合并）" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/vs_5"
            android:textColor="@color/dialog_text_hint"
            android:textSize="@dimen/ts_20"
            android:text="输入第二个 TVBox 配置地址，其站点/解析将合并进当前配置（同 key 去重，保留主源）" />

        <EditText
            android:id="@+id/inputSecondaryApi"
            android:layout_width="match_parent"
            android:layout_height="@dimen/vs_50"
            android:layout_marginTop="@dimen/vs_15"
            android:background="@drawable/input_search"
            android:hint="http://.../config.json"
            android:inputType="textUri"
            android:maxLines="1"
            android:paddingLeft="@dimen/vs_10"
            android:paddingRight="@dimen/vs_10"
            android:textColor="@color/dialog_text_primary"
            android:textColorHint="@color/dialog_text_hint"
            android:textSize="@dimen/ts_20" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/vs_15"
            android:orientation="horizontal"
            android:weightSum="2">

            <TextView
                android:id="@+id/btnClearSecondary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:background="@drawable/button_danmu_setting"
                android:clickable="true"
                android:focusable="true"
                android:padding="@dimen/vs_20"
                android:textColor="@color/dialog_text_primary"
                android:textSize="@dimen/ts_24"
                android:text="清除并取消合并" />

            <TextView
                android:id="@+id/btnConfirmSecondary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginLeft="@dimen/vs_10"
                android:gravity="center"
                android:background="@drawable/button_danmu_setting"
                android:clickable="true"
                android:focusable="true"
                android:padding="@dimen/vs_20"
                android:textColor="@color/dialog_text_primary"
                android:textSize="@dimen/ts_24"
                android:text="保存并合并" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
